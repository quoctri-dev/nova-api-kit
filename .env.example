# === NoVa API Kit — Environment Variables ===

# === REQUIRED (at least 1 provider) ===
# Get from: https://aistudio.google.com/apikey
GOOGLE_AI_API_KEY=

# Get from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# === SWAPPABLE ===
# Primary provider: gemini | claude (default: gemini — cheapest)
# Fallback: the other provider (auto if both keys present)
# Change in app sidebar or set here:
# PRIMARY_PROVIDER=gemini
# FALLBACK_PROVIDER=claude
